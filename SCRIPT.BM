' ===========================================================================
' SCRIPT.BM - the test hooks of the strategic game. Included at the end of
' WON.BAS. NAPSCRIPT.BM holds the same hooks for the tactical game. Until
' 2026-11-10 they were written so that PDS 7.1 compiled them too, for the
' bridge, now retired (docs\devnotes.md, item 60).
'
' An environment variable chooses how the program runs:
'   WON_SEED   RANDOMIZE takes this number instead of TIMER, and the program
'              is "scripted" (scripted = 1):
'              - each wait for a key is announced (announce, below), so that
'                a keys file gives each key only when the program waits;
'              - every TICK waits for a key (D2 of the plan), and its key is
'                thrown away, as TICK always did;
'              - the history file shows the date 06-24-1998, the date the
'                DOSBox-X sessions ran with;
'              - the copy of the history file is done in BASIC, not by a
'                SHELL of cmd.exe;
'              - each battle gets its own keys file, state file and seed
'                (scriptbattle), or with WON_OUTCOME set no battle at all;
'              - PLAY and SOUND are silent (silence, QB64.BM).
' A program started without it plays as before.
' ===========================================================================

' Chooses the mode from the environment. Runs first thing in WON.BAS.
SUB scriptstart
IF ENVIRON$("WON_SEED") <> "" THEN
	scripted = 1
	CALL silence
END IF
END SUB

' Seeds the random numbers, from WON_SEED when it is set, else from TIMER.
' It stands where WON.BAS had RANDOMIZE TIMER, the place that the
' recordings' WONSEED.EXE patched to RANDOMIZE 1# (tools\play\wonseed.py).
' VAL gives a DOUBLE, so WON_SEED=1 is the same RANDOMIZE 1#.
SUB scriptseed
seed$ = ENVIRON$("WON_SEED")
IF seed$ = "" THEN RANDOMIZE TIMER ELSE RANDOMIZE VAL(seed$)
END SUB

' The date of the history file's first line.
FUNCTION scriptdate$
IF scripted THEN scriptdate$ = "06-24-1998" ELSE scriptdate$ = DATE$
END FUNCTION

' Called first in TICK. Announces the pause as a wait at place 3, with the
' letter S when it is shorter than a second (the animations), so that a
' script's rule can answer those apart. When the program is scripted, it
' waits for a key and gives -1, and TICK returns. Otherwise it gives 0, and
' TICK pauses as before.
'
' A keys file answers a pause that read no key in DOS with F12, which the
' game reads nowhere else (tests\sessions\). Once read, F12 is taken
' back out of the BIOS buffer: the head and the tail go back one slot, to
' where they were before it was typed. The four PEEK(1052) = 30 checks of
' naval combat (WON2.BM) ask whether any key was typed since BuffClear, and
' DOS typed none in such a pause (docs\devnotes.md, "Step 7b"). A real key
' that a TICK reads stays counted, as in DOS. announce has set DEF SEG to 0.
FUNCTION scripttick% (sec!)
scripttick% = 0
IF scripted = 0 THEN EXIT FUNCTION
IF sec! < 1 THEN CALL announce(3, "S") ELSE CALL announce(3, "")
DO
	k$ = INKEY$
LOOP WHILE k$ = ""
IF k$ = CHR$(0) + CHR$(134) THEN
	slot = PEEK(1052) - 2
	IF slot < 30 THEN slot = 60
	POKE 1050, slot: POKE 1052, slot
END IF
scripttick% = -1
END FUNCTION

' Copies the file from$ to into$, as DOS's copy does: it replaces into$, and
' does nothing when from$ is not there. It copies 16 KB at a time: a PDS 7.1
' string holds at most 32,767 bytes, and the history file can grow larger.
SUB scriptcopy (from$, into$)
IF LEN(DIR$(from$)) = 0 THEN EXIT SUB
IF LEN(DIR$(into$)) > 0 THEN KILL into$
f = FREEFILE: OPEN from$ FOR BINARY AS #f
g = FREEFILE: OPEN into$ FOR BINARY AS #g
rest& = LOF(f)
DO WHILE rest& > 0
	n& = rest&: IF n& > 16384 THEN n& = 16384
	d$ = SPACE$(n&): GET #f, , d$: PUT #g, , d$
	rest& = rest& - n&
LOOP
CLOSE #g: CLOSE #f
END SUB

' SHELL cmd$, or under a script or off Windows the same work done in BASIC.
' The game runs "copy <from> <to>" (the history file of the game before,
' WON.BAS). QB64 runs copy through cmd.exe, whose console window shows on
' the user's desktop even when the program runs on a hidden one, so a script
' must not run it. Other systems have no copy command of that form.
SUB scriptshell (cmd$)
IF scripted = 0 AND onwindows% THEN SHELL cmd$: EXIT SUB
c$ = LTRIM$(RTRIM$(cmd$))
sp = INSTR(c$, " "): verb$ = LCASE$(LEFT$(c$, sp - 1)): args$ = LTRIM$(MID$(c$, sp + 1))
sp = INSTR(args$, " "): from$ = LEFT$(args$, sp - 1): into$ = LTRIM$(MID$(args$, sp + 1))
IF verb$ <> "copy" THEN SHELL cmd$: EXIT SUB
CALL scriptcopy(from$, into$)
END SUB

' Fights a battle in the tactical game: SHELL "napoleon.exe" (exename$:
' "./napoleon" off Windows), which waits until it ends. When the program is
' scripted:
'   - with WON_OUTCOME set, the file it names is copied to OUTCOME.&&& and no
'     battle is fought (D4 of the plan: session 9's run that is held to the
'     recorded outcome);
'   - otherwise the n-th battle of the run gets the keys file <keys>.battle<n>
'     and the state file <state>.battle<n>, from QB64_SCREEN_KEYS and
'     QB64_SCREEN_STATE, and NAP_SEED, which is WON_SEED unless NAP_SEED is
'     set already. The variables are put back after the battle: the screen
'     tool reads QB64_SCREEN_STATE again when it writes the strategic game's
'     states (docs\devnotes.md, "Step 3").
SUB scriptbattle
STATIC battles
IF scripted = 0 THEN SHELL exename$("napoleon"): EXIT SUB
o$ = ENVIRON$("WON_OUTCOME")
IF o$ <> "" THEN CALL scriptcopy(o$, "outcome.&&&"): EXIT SUB
battles = battles + 1: n$ = ".battle" + LTRIM$(STR$(battles))
k$ = ENVIRON$("QB64_SCREEN_KEYS"): s$ = ENVIRON$("QB64_SCREEN_STATE")
seed$ = ENVIRON$("NAP_SEED")
IF k$ <> "" THEN ENVIRON "QB64_SCREEN_KEYS=" + k$ + n$
IF s$ <> "" THEN ENVIRON "QB64_SCREEN_STATE=" + s$ + n$
IF seed$ = "" THEN ENVIRON "NAP_SEED=" + ENVIRON$("WON_SEED")
SHELL exename$("napoleon")
IF k$ <> "" THEN ENVIRON "QB64_SCREEN_KEYS=" + k$
IF s$ <> "" THEN ENVIRON "QB64_SCREEN_STATE=" + s$
IF seed$ = "" THEN ENVIRON "NAP_SEED="
END SUB

' Says that the program is about to wait for a key, when it is scripted.
' place names the kind of wait (1 to 255) and letter$ narrows it
' (its first character, or ""):
'   1  a pause that any key ends ("press a key", the player's turn)
'   2  a menu; letter$ is the first letter of the menu's title
'   3  TICK; letter$ is S for a pause shorter than a second
'   4  a line of text (the commander's name in the Hall of Fame)
' Byte &H4F1 holds the place, &H4F2 the letter, and &H4F0 counts the waits:
' QB64Rust's tools\screen\README.md, "Prompts".
' It leaves DEF SEG at 0, as BuffClear does: the four PEEK(1052) checks in
' WON2.BM read after BuffClear without setting DEF SEG again, and a plain
' DEF SEG here would make them read elsewhere.
SUB announce (place, letter$)
IF scripted = 0 THEN EXIT SUB
code = 0
IF letter$ <> "" THEN code = ASC(UCASE$(letter$))
DEF SEG = 0
POKE &H4F1, place
POKE &H4F2, code
POKE &H4F0, (PEEK(&H4F0) + 1) AND 255
END SUB
