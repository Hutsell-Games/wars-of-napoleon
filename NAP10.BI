most = 80: m1 = .5 * most: m2 = .5 * most + 1
DIM SHARED unitx(most), unity(most), unit$(most), strength(most), Visible(most)
DIM SHARED terrain(most), morale(most), leader(most), uorder(most), leadbase(2)
DIM SHARED toa(most), name$(most), score&(2), adj1$(5), adj2$(5), adj3$(5)
