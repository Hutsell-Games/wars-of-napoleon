	CASE 2: a = 63: x = 40: y = 0
	CASE 3: a = 10: x = 10: y = 30
	CASE 4: a = 30: x = 10: y = 10
	CASE ELSE: a = 0: x = 34: y = 0
END SELECT
PAINT (200, 200), 2, 10
c& = 65536 * a + 256 * x + y
PALETTE 2, c&
